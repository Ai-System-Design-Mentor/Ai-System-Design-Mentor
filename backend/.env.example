# ─── Database ────────────────────────────────────────────────────────────────
# Get from: MongoDB Atlas → Your Cluster → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ai_mentor?retryWrites=true&w=majority

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_strong_random_secret_minimum_32_chars

# ─── AI ──────────────────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Frontend URL (CORS) ─────────────────────────────────────────────────────
# In production, set this to your actual deployed frontend domain
CLIENT_URL=http://localhost:5173

# ─── Email (Gmail SMTP) ──────────────────────────────────────────────────────
# Use a Gmail App Password (not your main password)
# Setup: Google Account → Security → 2-Step Verification → App Passwords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_gmail_app_password_here

# ─── Google OAuth ────────────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ─── GitHub OAuth ────────────────────────────────────────────────────────────
# Get from: GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret