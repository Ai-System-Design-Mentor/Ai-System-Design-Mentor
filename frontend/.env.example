# ─── Backend API ─────────────────────────────────────────────────────────────
# In development, Vite proxies /api to localhost:5001 automatically.
# In production, set this to your deployed backend URL.
VITE_API_URL=http://localhost:5001/api

# ─── Google OAuth ────────────────────────────────────────────────────────────
# Must match the CLIENT_ID in your backend .env
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
VITE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ─── GitHub OAuth ────────────────────────────────────────────────────────────
# Must match the GITHUB_CLIENT_ID in your backend .env
VITE_GITHUB_CLIENT_ID=your_github_oauth_client_id
